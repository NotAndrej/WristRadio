<?xml version="1.0" encoding="utf-8"?>
<!--
  WristRadio launcher glyph, hand-authored as a vector: a broadcast emitter -
  a solid core with two pairs of signal arcs fanning out either side. Drawn
  inside the adaptive-icon safe zone (the 66dp circle centred on 54,54), so it
  survives both the round and the squircle masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outermost arcs -->
    <path
        android:pathData="M36,36 C26,44 26,64 36,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M72,36 C82,44 82,64 72,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- inner arcs -->
    <path
        android:pathData="M45,44 C38,48 38,60 45,64"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M63,44 C70,48 70,60 63,64"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- the emitter -->
    <path
        android:fillColor="#FFD166"
        android:pathData="M54,54 m-8,0 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0" />
</vector>
